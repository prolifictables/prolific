{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@prolific/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@prolific/utils": ["../../packages/utils/src/index.ts"],
      "@prolific/validation": ["../../packages/validation/src/index.ts"],
      "@prolific/ui": ["../../packages/ui/src/index.ts"]
    },
    "types": ["vite/client", "node", "electron"]
  },
  "include": [
    "electron/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "release"]
}
