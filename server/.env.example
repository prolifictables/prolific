# Server environment variables — copy to .env for local dev

NODE_ENV=development
PORT=4000

# MongoDB Atlas (Phase 1 dev can also be a local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/prolific_dev?replicaSet=rs0&directConnection=true

# JWT secrets
JWT_ACCESS_SECRET=replace-me-with-32-byte-random
JWT_REFRESH_SECRET=replace-me-with-64-byte-random-different
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=prolific.pos
JWT_AUDIENCE=prolific.clients

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Payment providers (test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Super admin seed
SEED_SUPERADMIN_EMAIL=superadmin@prolific.app
SEED_SUPERADMIN_PASSWORD=Admin123!
SEED_SUPERADMIN_FIRSTNAME=Super
SEED_SUPERADMIN_LASTNAME=Admin

# Rate limits (per-minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEFAULT=500
